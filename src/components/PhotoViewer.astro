<dialog class="photo-viewer" aria-label="Full-size photo viewer">
  <div class="viewer-toolbar">
    <span class="viewer-position" aria-live="polite"></span>
    <a class="viewer-original" target="_blank" rel="noopener">Open original ↗</a>
    <button type="button" class="viewer-close" aria-label="Close photo viewer">Close ×</button>
  </div>
  <div class="viewer-stage">
    <button type="button" class="viewer-previous" aria-label="Previous photo">‹</button>
    <img class="viewer-image" alt="" />
    <button type="button" class="viewer-next" aria-label="Next photo">›</button>
  </div>
  <p class="viewer-caption" aria-live="polite"></p>
</dialog>
<script>
  const dialog=document.querySelector<HTMLDialogElement>('.photo-viewer');
  if(dialog){
    const photos=Array.from(document.querySelectorAll<HTMLAnchorElement>('.article-body a[data-fullsize-photo]'));
    const image=dialog.querySelector<HTMLImageElement>('.viewer-image');
    const original=dialog.querySelector<HTMLAnchorElement>('.viewer-original');
    const caption=dialog.querySelector<HTMLElement>('.viewer-caption');
    const position=dialog.querySelector<HTMLElement>('.viewer-position');
    const previous=dialog.querySelector<HTMLButtonElement>('.viewer-previous');
    const next=dialog.querySelector<HTMLButtonElement>('.viewer-next');
    let selected=0;
    let opener: HTMLAnchorElement;
    let priorOverflow='';
    function show(index:number){
      selected=(index+photos.length)%photos.length;
      const photo=photos[selected];
      image.src=photo.href;
      image.alt=photo.querySelector('img')?.alt||'';
      original.href=photo.href;
      caption.textContent=photo.closest('figure')?.querySelector('figcaption')?.textContent||image.alt;
      position.textContent=`Photo ${selected+1} of ${photos.length}`;
      previous.hidden=next.hidden=photos.length<2;
    }
    photos.forEach((photo,index)=>photo.addEventListener('click',event=>{
      if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
      event.preventDefault();opener=photo;show(index);
      priorOverflow=document.body.style.overflow;
      document.body.style.overflow='hidden';
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('.viewer-close').focus();
    }));
    previous.addEventListener('click',()=>show(selected-1));
    next.addEventListener('click',()=>show(selected+1));
    dialog.querySelector('.viewer-close').addEventListener('click',()=>dialog.close());
    dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
    dialog.addEventListener('keydown',event=>{
      if(event.key==='ArrowLeft'){event.preventDefault();show(selected-1);}
      if(event.key==='ArrowRight'){event.preventDefault();show(selected+1);}
    });
    dialog.addEventListener('close',()=>{
      document.body.style.overflow=priorOverflow;
      image.removeAttribute('src');
      opener?.focus({preventScroll:true});
    });
  }
</script>
<style>
  .photo-viewer{position:fixed;inset:0;width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:16px;border:0;background:rgba(15,20,25,.97);color:#fff;overflow:auto}
  .photo-viewer::backdrop{background:#0f1419}
  .photo-viewer[open]{display:flex;flex-direction:column;gap:12px}
  .viewer-toolbar{display:flex;align-items:center;gap:16px;flex-wrap:wrap;flex-shrink:0}
  .viewer-position{margin-right:auto;font-size:.9rem}
  .viewer-original{color:#fff;text-decoration:underline}
  button{font:inherit;color:#fff;background:#ffffff18;border:1px solid #ffffff50;border-radius:6px;min-width:44px;min-height:44px;cursor:pointer;padding:6px 12px}
  button:hover{background:#ffffff30}
  :is(button,a):focus-visible{outline:3px solid #8ecbff;outline-offset:3px}
  .viewer-stage{display:flex;align-items:center;justify-content:center;gap:12px;flex:1;min-height:0;pointer-events:none}
  .viewer-stage>*{pointer-events:auto}
  .viewer-image{display:block;min-width:0;max-width:calc(100% - 112px);max-height:calc(100dvh - 160px);width:auto;height:auto;object-fit:contain}
  .viewer-caption{margin:0;text-align:center;flex-shrink:0;font-size:.95rem}
  .viewer-previous,.viewer-next{font-size:2rem;flex-shrink:0}
  @media(max-width:540px){.photo-viewer{padding:12px}.viewer-stage{gap:4px}.viewer-image{max-width:calc(100% - 96px)}.viewer-toolbar{gap:8px}.viewer-position{width:100%}}
</style>
