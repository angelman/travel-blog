---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: string; alt: string; gallery?: boolean; priority?: boolean; }
const { src, alt, gallery = false, priority = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/media/**/*.{jpg,jpeg,png,webp}', { eager: true });
const image = images['/src/assets' + src]?.default;
if (!image) throw new Error(`Unknown photo: ${src}`);
const max = gallery ? 960 : 1520;
const widths = [...new Set([320, 640, 960, max].map(width => Math.min(width, image.width, max)))];
---
<a href={src} data-fullsize-photo aria-label={alt ? `Enlarge photo: ${alt}` : 'Enlarge photo'}>
<Image src={image} alt={alt} format="webp" quality={80}
  width={Math.min(image.width,max)} widths={widths}
  sizes={gallery ? '(max-width: 480px) calc(100vw - 40px), (max-width: 700px) 45vw, 250px' : '(max-width: 820px) calc(100vw - 40px), 760px'}
  loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} />
</a>
<style>
  a { cursor: zoom-in; display: block; }
  a:focus-visible { outline: 3px solid #2c76b8; outline-offset: 4px; }
</style>
